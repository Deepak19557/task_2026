<div class="cogie-auth-page">
  <div class="cogie-auth-card">

    <!-- Left Visual Panel -->
    <div class="cogie-visual-panel">
      <div class="cogie-visual-inner" role="img" aria-label="A Wise Quote: Get Everything You Want. You can get everything you want if you work hard, trust the process, and stick to the plan.">
      </div>
    </div>

    <!-- Right Form Panel -->
    <div class="cogie-form-panel">
      <!-- Brand Logo -->
      <div class="cogie-brand-header">
        <img src="/cogie_logo_transparent.png" alt="Cogie" class="cogie-brand-img">
      </div>

      <div class="cogie-auth-content cogie-edit-content">
        <h1 class="cogie-auth-title">Edit Profile</h1>
        <p class="cogie-auth-subtitle">Update your personal account details</p>

        <% if notice %>
          <div class="cogie-flash cogie-flash-notice"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="cogie-flash cogie-flash-alert"><%= alert %></div>
        <% end %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "cogie-auth-form" }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div style="display: flex; gap: 10px;">
            <div class="cogie-form-group" style="flex: 1;">
              <%= f.label :first_name, "First Name", class: "cogie-label" %>
              <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", placeholder: "First name", class: "cogie-input" %>
            </div>

            <div class="cogie-form-group" style="flex: 1;">
              <%= f.label :last_name, "Last Name", class: "cogie-label" %>
              <%= f.text_field :last_name, autocomplete: "family-name", placeholder: "Last name", class: "cogie-input" %>
            </div>
          </div>

          <div class="cogie-form-group">
            <%= f.label :age, "Age", class: "cogie-label" %>
            <%= f.number_field :age, min: 1, max: 120, placeholder: "Your age", class: "cogie-input" %>
          </div>

          <div class="cogie-form-group">
            <%= f.label :email, "Email", class: "cogie-label" %>
            <%= f.email_field :email, autocomplete: "email", placeholder: "Enter your email", class: "cogie-input", required: true %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <div class="cogie-form-hint" style="margin-bottom: 12px; color: #d97706;">
              Currently waiting confirmation for: <%= resource.unconfirmed_email %>
            </div>
          <% end %>

          <div class="cogie-form-group">
            <%= f.label :password, class: "cogie-label" do %>
              New Password <span class="cogie-form-hint">(leave blank to keep current)</span>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "New password", class: "cogie-input" %>
          </div>

          <div class="cogie-form-group">
            <%= f.label :password_confirmation, "Confirm New Password", class: "cogie-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password", class: "cogie-input" %>
          </div>

          <div class="cogie-form-group">
            <%= f.label :current_password, class: "cogie-label" do %>
              Current Password <span class="cogie-form-hint">(required to confirm changes)</span>
            <% end %>
            <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Enter current password", class: "cogie-input", required: true %>
          </div>

          <div class="cogie-actions" style="margin-top: 18px;">
            <%= f.submit "Update Profile", class: "cogie-btn-submit" %>
          </div>
        <% end %>

        <div class="cogie-edit-footer">
          <%= link_to "← Back", root_path, class: "cogie-back-link" %>
          <%= button_to "Delete Account", registration_path(resource_name), data: { confirm: "Are you sure you want to cancel your account?", turbo_confirm: "Are you sure you want to cancel your account?" }, method: :delete, class: "cogie-btn-danger-link" %>
        </div>
      </div>
    </div>

  </div>
</div>
