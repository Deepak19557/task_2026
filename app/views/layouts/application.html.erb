<!DOCTYPE html>
<html>
  <head>
    <title>Task2026</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="<%= 'cogie-auth-layout' if devise_controller? %>">
    <% unless devise_controller? %>
      <nav>
        <% if user_signed_in? %>
          <p>Logged in as <strong><%= current_user.first_name.presence || current_user.email %></strong> | <%= link_to 'Edit profile', edit_user_registration_path %> | <%= link_to 'Sign out', destroy_user_session_path, method: :delete %></p>
        <% else %>
          <p><%= link_to 'Sign in', new_user_session_path %> | <%= link_to 'Sign up', new_user_registration_path %></p>
        <% end %>
      </nav>
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>
    <% end %>
    <%= yield %>
  </body>
</html>
